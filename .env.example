# Google Sheets backend (required)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Recommended: absolute path to the downloaded service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative: provide the credential fields directly.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep literal \n in this env value; runtime converts it to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Required only while initializing an empty Users worksheet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional one-time provisioning for the protected global administrator.
GLOBAL_ADMIN_USERNAME=
GLOBAL_ADMIN_EMAIL=
GLOBAL_ADMIN_PASSWORD=

# Optional external AI integration. Current MVP has deterministic local insights.
AI_PROVIDER=
AI_API_KEY=
