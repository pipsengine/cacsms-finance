# Google Sheets backend (optional for demo mode)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep literal \n in this env value; runtime converts it to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional external AI integration. Current MVP has deterministic local insights.
AI_PROVIDER=
AI_API_KEY=
